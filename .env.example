# EonTrading — single .env file
# Copy to .env and fill in your values.

# === Logging (system-wide) ===
# LOG_OUTPUT=text  # "json" (structured) or "text" (human-readable)

# === MongoDB (required) ===
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net
MONGODB_USER=
MONGODB_PASS=
MONGODB_CLUSTERNAME=

# === Redis (optional — only for distributed mode) ===
REDIS_HOST=localhost
# REDIS_PORT=6379

# === News sources (pick what you need) ===
NEWSAPI_KEY=
FINNHUB_KEY=
TWITTER_BEARER_TOKEN=
# PERSIST_NEWS=1
# PUBLISH_PIPELINE=1

# === Sentiment analyzer (default: keyword, free) ===
# ANALYZER=keyword  # "keyword" or "llm"
# LLM_PROVIDER=opencode  # "opencode", "openai", "azure", or "" (auto: opencode if its key is set)
# TRADABLE_MARKETS=HK  # comma-separated: HK, US, etc. — steers LLM symbol focus
# --- Option 1: OpenAI ---
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# --- Option 2: Azure OpenAI ---
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://<instance>.openai.azure.com/openai/v1
# OPENAI_MODEL=<deployment-name>
# OPENAI_API_VERSION=2024-06-01
# --- Option 3: OpenCode (free) ---
# OPENCODE_API_KEY=sk-...
# OPENCODE_BASE_URL=https://opencode.ai/zen/v1
# OPENCODE_MODEL=big-pickle

# === Trading parameters (defaults shown) ===
# THRESHOLD=0.4
# MIN_CONFIDENCE=0.15
# MAX_ALLOCATION=0.2
# STOP_LOSS_PCT=0.05
# TAKE_PROFIT_PCT=0.10

# === Broker (default: paper/log, no API key needed) ===
# Options: log (no-op) | paper (simulated fills) | futu | ibkr | alpaca | webull
BROKER=log
# FUTU_REAL=false
# FUTU_CONFIRM=poll
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# WEBULL_REAL=false   # false = sandbox (paper), true = live
# WEBULL_APP_KEY=
# WEBULL_APP_SECRET=
# WEBULL_ACCOUNT_ID=
